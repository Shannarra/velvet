puts "Numbers from 1 to 10:"
from i = 1 to 11 do
	puts i
end

puts "Numbers from 1 to 100 with increment 5:"

from i = 1 to 101 do
	if i % 5 == 0 do
		 puts i
	end
end


puts "Inverted from does not execute:"
from i = 10 to 0 do
	puts i
end

array = [1,2,3,4,5]

array[1] = if array[1] == 2 do
				 			70
					 else
							69
					end
array[2] = 69

from i = 0 to 5 do
	puts array[i]
end

